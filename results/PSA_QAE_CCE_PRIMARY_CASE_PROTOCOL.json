{
  "schema": "psa-qae-cce-primary-case-protocol/v1",
  "frozen_on": "2026-10-09",
  "role": "primary CCE decision experiment",
  "outer_decision": {
    "variable": "product-gas recycle fraction",
    "candidate_values": [
      0.42,
      0.427,
      0.43
    ],
    "rule": "largest recycle candidate with estimated event probability >= target_probability"
  },
  "inner_estimand": {
    "purity_threshold": 0.9998,
    "recovery_threshold": 0.789,
    "logical_form": "H2_product >= purity_threshold AND H2_recovery_external_proxy >= recovery_threshold"
  },
  "chance_constraint_target": 0.5,
  "uncertainty_prior": {
    "physical_design_rows": 32,
    "features": [
      "source_h2",
      "source_co2",
      "source_ch4",
      "source_co",
      "source_n2",
      "capacity_factor",
      "affinity_factor",
      "ldf_factor",
      "P_low_bar",
      "equalization_conductance",
      "recycle_fraction"
    ],
    "model": "linear purity/recovery response surface plus regularized empirical Gaussian copula",
    "source_file": "psa_qae/psa_two_bed_spatial_tank_n2_independent_source_uncertainty_32.csv"
  },
  "estimators": {
    "MC": {
      "samples": 3500
    },
    "RQMC": {
      "samples": 4096,
      "sequence": "independently scrambled Sobol"
    },
    "IS": {
      "samples": 3500,
      "proposal": "equal mixture of N(0,I), N(+shift,I), and N(-shift,I) in independent Gaussian-copula latent space"
    },
    "MLAE": {
      "queries": 3500,
      "powers": [
        0,
        1,
        2,
        4,
        8
      ],
      "shots_per_power": 100
    }
  },
  "primary_endpoints": [
    "probability RMSE, MAE, and bias",
    "chance-constraint classification error",
    "outer-policy misselection probability",
    "surrogate evaluations or amplitude-oracle queries",
    "wall time labelled by computation type",
    "importance-sampling ESS and maximum normalized weight"
  ],
  "allowed_claim": "resource-aware estimator and policy-selection comparison conditional on the declared PSA surrogate and prior",
  "prohibited_claims": [
    "industrial H2 plant validation",
    "global PSA optimum",
    "end-to-end quantum speedup",
    "equivalent surrogate and QPU wall time"
  ],
  "secondary_controls": [
    "direct finite physical policy table",
    "TU Wien H2/CH4 calibration",
    "Otway valve-pressure check",
    "IBM QPU hardware boundary"
  ]
}
